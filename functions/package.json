{
  "name": "calorix-functions",
  "description": "Calorix Cloud Functions",
  "scripts": {
    "lint": "eslint src test test-emulator",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:emulator": "vitest run --config vitest.emulator.config.ts",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "test:rules:attached": "vitest run --config vitest.rules-attached.config.ts",
    "test:data-emulators": "firebase emulators:exec --only auth,firestore,storage \"npm run test:rules:attached && npm run test:emulator\"",
    "test:functions-load": "firebase emulators:exec --only functions \"node test/noop-load.js\"",
    "test:verify": "npm run build && npm run lint && npm test && npm run test:data-emulators && npm run test:functions-load",
    "eval:nutrition:fixtures": "vitest run test/nutrition-eval",
    "eval:nutrition:baseline": "npm run build && node lib/nutrition-eval/cli.js baseline",
    "eval:nutrition:release": "npm run build && node lib/nutrition-eval/cli.js release",
    "deploy": "firebase deploy --only functions"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google/genai": "2.19.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^20.14.0",
    "eslint": "^9.9.0",
    "firebase": "^11.1.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vitest": "^2.1.9"
  },
  "private": true
}
